# models: set any of the keys; each one adds its models to the picker in the app
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional: lists shown in the picker (id:Label,…), the default, which provider comes first
# ANTHROPIC_MODELS=claude-sonnet-5-5:Claude Sonnet 5.5,claude-haiku-5-5:Claude Haiku 5.5
# OPENAI_MODELS=gpt-6-luna:GPT-6 Luna,gpt-6-astra:GPT-6 Astra,gpt-5.3-codex:Codex (GPT-5.3)
# DEFAULT_MODEL=gpt-6-luna
# LLM_PROVIDER=openai
OPENAI_REASONING=low
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# optional
ROOM_CALL_LIMIT=30
DISPLAY_TZ=Asia/Seoul
